echo "HUSKY: Running pre-commit hooks..."

# Check if lint-staged is installed
if [ -f "$(npx -y find-exec lint-staged)" ]; then
  echo "HUSKY: Lint-staged found, running..."
  npx lint-staged
else
  echo "HUSKY: lint-staged not found, skipping..."
fi

# Check if ESLint is installed
if [ -f "$(npx -y find-exec eslint)" ]; then
  echo "HUSKY: ESLint found, running..."
  npx eslint .
else
  echo "HUSKY: ESLint not found, skipping..."
fi